    "lint": "bun lint",
    "ci": "bun run lint && bun run check && bun run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/dm-sans": "^5.3.0",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/material-symbols": "^1.2.98",
    "@inlang/paraglide-js": "^3.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/web-push": "^3.6.4",
    "daisyui": "^5.7.50",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "potrace": "^2.1.8",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wawoff2": "^2.0.1"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@mlc-ai/web-llm": "0.2.87",
    "mysql2": "^3.24.6",
    "onnxruntime-web": "1.31.1",
    "web-push": "^4.0.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
