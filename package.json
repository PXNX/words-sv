{
  "name": "word-circle-sv",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build && node scripts/og.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --config tests/vitest.server.config.mjs",
