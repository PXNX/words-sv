{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src",
    "scripts/*.ts",
    "eslint.config.ts",
    "vite.config.ts",
    "tests"
  ]
}
