# Copy to .env and fill in real values. Never commit .env or any real key.
# These values are for the server-side Vercel functions, not the static SPA.

# MySQL/TiDB connection used by the reminder API.
# For TiDB Cloud add TLS, for example:
# DATABASE_URL="mysql://user:password@host:4000/wordcircle?ssl={\"rejectUnauthorized\":true}"
DATABASE_URL="mysql://user:password@host:3306/wordcircle"

# Web Push / VAPID. Generate with: npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: contact URI.
VAPID_SUBJECT="mailto:you@example.com"
VAPID_PUBLIC_KEY="replace-with-public-key"
VAPID_PRIVATE_KEY="replace-with-private-key"

# Bearer token for the external reminder scheduler.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="replace-with-a-long-random-secret"

# Optional: public site origin used when generating Open Graph pages and cards.
# VERCEL_PROJECT_PRODUCTION_URL is provided automatically by Vercel.
PUBLIC_SITE_URL="https://words-sv.vercel.app"
