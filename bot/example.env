# Bot token from @BotFather (never commit the real value)
TELEGRAM=123456789:replace-me
# Telegram user ids that get a message for every donation
ADMINS=[]
# PostgreSQL for the donation ledger
DATABASE_URL=postgresql://words:password@localhost:5432/words
# Same value as TELEGRAM_BRIDGE_SECRET on the app's server: lets the bot forward sign-in, reminder and invite links
TELEGRAM_BRIDGE_SECRET=
# Optional overrides
WORDS_URL=https://words-sv.vercel.app
# Set after `npm run deploy` in miniapp/ prints https://app<id>.tgcloud.ai/
MINIAPP_URL=
LEGAL_BASE_URL=https://words-sv.vercel.app
SUPPORT_CONTACT=https://words-sv.vercel.app/impressum
