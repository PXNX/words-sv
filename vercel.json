{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
	"bunVersion": "1.4.x",
	"installCommand": "bun install --frozen-lockfile",
	"buildCommand": "bun run build",
  "outputDirectory": "build",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(circle(?:/definitions)?|wordle|hangman|taboo|vocab|sentence(?:/full)?|pronunciation|conversation|alltag|grammar|stories|reading|listen|progress|repeat|stats|settings|changelog|placement|mock|dictionary|insights|store|impressum|datenschutz|bedingungen)/?", "dest": "/$1/index.html" }
  ]
}
