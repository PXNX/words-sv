{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
	"installCommand": "pnpm install --frozen-lockfile",
	"buildCommand": "pnpm run build",
  "outputDirectory": "build",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(circle|wordle|vocab|settings)/?", "dest": "/index.html" }
  ]
}
